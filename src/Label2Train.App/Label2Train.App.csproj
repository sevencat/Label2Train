<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Label2Train.App</RootNamespace>
    <AssemblyName>Label2Train.App</AssemblyName>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationIcon>..\..\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="..\..\app.png" Link="Assets\app.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Label2Train.Core\Label2Train.Core.csproj" />
    <ProjectReference Include="..\Label2Train.Label\Label2Train.Label.csproj" />
    <ProjectReference Include="..\Label2Train.Train\Label2Train.Train.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.HarfBuzz" />
    <PackageReference Include="Avalonia.Native" />
    <PackageReference Include="Avalonia.Skia" />
    <PackageReference Include="Avalonia.Win32" />
    <PackageReference Include="Oxyplot.Avalonia" />
    <PackageReference Include="Sevencat.ImageFacade.SkiaSharp" />
    <PackageReference Include="Sevencat.OnnxSharp" />
    <PackageReference Include="Material.Avalonia" />
    <PackageReference Include="Material.Icons.Avalonia" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Sevencat.ImageFacade" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <!-- 纯源生成器，不参与运行时：注册代码在编译期生成，别传给下游项目 -->
    <PackageReference Include="Injectio" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- 只跑 Windows：这几个包是 SkiaSharp / HarfBuzzSharp 的平台原生资产（传递依赖带进来的），
         显式引用只为把它 ExcludeAssets 掉，输出目录里不再有 linux / macOS / wasm 的原生库 -->
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Linux" ExcludeAssets="all" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.macOS" ExcludeAssets="all" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.WebAssembly" ExcludeAssets="all" />
    <PackageReference Include="SimdSkia.Avalonia.Desktop" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" ExcludeAssets="all" />
    <PackageReference Include="SkiaSharp.NativeAssets.macOS" ExcludeAssets="all" />
    <PackageReference Include="SkiaSharp.NativeAssets.WebAssembly" ExcludeAssets="all" />
  </ItemGroup>

</Project>
