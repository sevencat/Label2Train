<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Label2Train.App.ViewModels"
        xmlns:l="using:Label2Train.App.Localization"
        xmlns:loc="using:Label2Train.Core.Localization"
        xmlns:views="using:Label2Train.App.Views"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        x:Class="Label2Train.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        Icon="/Assets/app.png"
        Width="1280" Height="840"
        MinWidth="1120" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource CanvasBackgroundBrush}"
        WindowDecorations="BorderOnly">

  <Window.Styles>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="12" />
    </Style>
    <Style Selector="Border.badge">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="7,1" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.caption">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Opacity" Value="0.55" />
    </Style>
    <Style Selector="ListBox.plain">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>
    <Style Selector="ListBox.plain ListBoxItem">
      <Setter Property="Padding" Value="12,0" />
    </Style>
    <!-- 顶栏的「标注 / 训练」分段切换 -->
    <Style Selector="ToggleButton.nav">
      <Setter Property="Padding" Value="14,4" />
      <Setter Property="MinWidth" Value="76" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ToggleButton.nav:checked">
      <Setter Property="Background" Value="#337C4DFF" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="ToggleButton.nav:checked /template/ ContentPresenter">
      <Setter Property="Background" Value="#337C4DFF" />
    </Style>
    <!-- 自绘标题栏的窗口按钮：贴边、无圆角，悬停变亮，关闭键悬停变红 -->
    <Style Selector="Button.caption">
      <Setter Property="Width" Value="46" />
      <Setter Property="Height" Value="36" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#E9E9EE" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.caption:pointerover">
      <Setter Property="Background" Value="#26FFFFFF" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="Button.caption:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#26FFFFFF" />
    </Style>
    <Style Selector="Button.caption.close:pointerover">
      <Setter Property="Background" Value="#C42B1C" />
    </Style>
    <Style Selector="Button.caption.close:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#C42B1C" />
    </Style>
  </Window.Styles>

  <!-- 根：深色自绘标题栏 + 原有内容（窗口已 ExtendClientArea，标题栏整宽贴边） -->
  <Grid RowDefinitions="Auto,*">

    <Border Grid.Row="0" Height="36" Background="#1B1B21"
            PointerPressed="OnTitleBarPressed">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8"
                    Margin="12,0,0,0" VerticalAlignment="Center">
          <Image Source="/Assets/app.png" Width="32" Height="32" />
          <TextBlock Text="{Binding Title}" FontSize="13" Foreground="#F0F0F2"
                     VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal">
          <Button Classes="caption" Click="OnMinimizeClick" ToolTip.Tip="{l:Loc Common.Minimize}">
            <materialIcons:MaterialIcon Kind="WindowMinimize" Width="10" Height="10" />
          </Button>
          <Button Classes="caption" Click="OnMaximizeClick" ToolTip.Tip="{l:Loc Common.Maximize}">
            <Panel>
              <materialIcons:MaterialIcon x:Name="MaximizeIcon" Kind="WindowMaximize" Width="10" Height="10" />
              <materialIcons:MaterialIcon x:Name="RestoreIcon" Kind="WindowRestore" Width="10" Height="10"
                                         IsVisible="False" />
            </Panel>
          </Button>
          <Button Classes="caption close" Click="OnCloseClick" ToolTip.Tip="{l:Loc Common.Close}">
            <materialIcons:MaterialIcon Kind="Close" Width="12" Height="12" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" RowDefinitions="Auto,*,Auto" Margin="8" RowSpacing="8">

      <!-- 顶栏 -->
    <Border Grid.Row="0" Classes="card" Padding="12,8">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto" ColumnSpacing="10">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <TextBlock Text="{l:Loc Label.Title}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
          <Border CornerRadius="9" Padding="8,1" Background="#1F16A34A" VerticalAlignment="Center">
            <TextBlock Text="{l:Loc Label.Running}" FontSize="13" Foreground="#16A34A" />
          </Border>
        </StackPanel>

        <!-- 标注 / 训练 切换：训练页从 Annotrain 移植，默认显示标注页 -->
        <Border Grid.Column="1" VerticalAlignment="Center" CornerRadius="6" Padding="2"
                BorderThickness="1" BorderBrush="{DynamicResource PanelBorderBrush}"
                Background="#0D000000">
          <StackPanel Orientation="Horizontal" Spacing="2">
            <ToggleButton x:Name="AnnotateTab" Classes="nav"
                          Content="{l:Loc Nav.Annotate}" IsChecked="True"
                          Click="OnShowAnnotation" ToolTip.Tip="{l:Loc Nav.AnnotateTip}" />
            <ToggleButton x:Name="TrainTab" Classes="nav"
                          Content="{l:Loc Nav.Train}"
                          Click="OnShowTraining" ToolTip.Tip="{l:Loc Nav.TrainTip}" />
          </StackPanel>
        </Border>

        <ComboBox Grid.Column="3" x:Name="LanguageBox"
                  ItemsSource="{Binding Languages}"
                  SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                  MinWidth="124" VerticalAlignment="Center"
                  ToolTip.Tip="{l:Loc Common.Language}">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="loc:LanguageOption">
              <TextBlock Text="{Binding DisplayName}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>

        <Button Grid.Column="4" Content="{l:Loc Label.OpenDataDir}" Click="OnOpenDataFolder" />
        <Button Grid.Column="5" Content="{l:Loc Label.About}" Click="OnAbout" />
        <Button Grid.Column="6" Content="{l:Loc Label.Log}" Click="OnOpenLog" />
      </Grid>
    </Border>

    <!-- 主体：标注 / 训练 各是一个独立控件，按模式互斥显示（训练页的可见性由它自己绑） -->
    <views:AnnotationView x:Name="AnnotationPanel" Grid.Row="1" IsVisible="{Binding IsAnnotationMode}" />
    <views:TrainView Grid.Row="1" DataContext="{Binding Train}" />

    <!-- 底栏：数据库位置 + 软件信息（日志在右上角按钮里） -->
    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="12">
      <TextBlock Text="{Binding FooterText}" FontSize="13" Opacity="0.55" VerticalAlignment="Center"
                 TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding DatabasePath}" />

      <TextBlock Grid.Column="1" Text="{Binding ProductInfoText}" FontSize="13" Opacity="0.45"
                 VerticalAlignment="Center" ToolTip.Tip="{Binding ProductInfoText}" />
    </Grid>
    </Grid>
  </Grid>
</Window>
