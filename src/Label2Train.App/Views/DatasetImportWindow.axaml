<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:Label2Train.App.Localization"
        x:Class="Label2Train.App.Views.DatasetImportWindow"
        Title="{l:Loc Import.Title}"
        Width="520" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

  <StackPanel Margin="20" Spacing="10">
    <TextBlock Text="{l:Loc Import.Title}" FontSize="16" FontWeight="SemiBold" />

    <!-- 校验结果：格式 + 探测器给出的说明 -->
    <TextBlock x:Name="ProbeText" Opacity="0.75" FontSize="12" TextWrapping="Wrap" />
    <TextBlock x:Name="SourceText" Opacity="0.55" FontSize="12" TextWrapping="Wrap" />

    <TextBlock Text="{l:Loc Import.ProjectName}" FontWeight="SemiBold" Margin="0,6,0,0" />
    <TextBox x:Name="NameBox" PlaceholderText="{l:Loc Import.NamePlaceholder}" MaxLength="128" />

    <TextBlock x:Name="ErrorText" Foreground="#EF4444" FontSize="12" MinHeight="16" TextWrapping="Wrap" />

    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,4,0,0">
      <Button Content="{l:Loc Common.Cancel}" Click="OnCancel" IsCancel="True" />
      <Button Content="{l:Loc Import.Action}" Click="OnConfirm" IsDefault="True" />
    </StackPanel>
  </StackPanel>

</Window>
